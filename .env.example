# ---------------------------------------------------------------------------
# OKAYiT - Environment configuration template
# Copy this file to `.env` and fill in real values. NEVER commit your real .env.
# ---------------------------------------------------------------------------

# Database (PostgreSQL connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# NextAuth
# NEXTAUTH_URL is the base URL of the running app (e.g. http://localhost:3000 in dev)
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Admin / staff auth
ADMIN_JWT_SECRET=""
STAFF_ADMIN_PASSWORD=""

# Seed script password (used by scripts/seed.ts for demo accounts)
SEED_ADMIN_PASSWORD=""

# Abacus.AI platform APIs (LLM, notifications, PDF, FFmpeg)
ABACUSAI_API_KEY=""
WEB_APP_ID=""

# Email notification type IDs (from the platform notification settings)
NOTIF_ID_WELLBEING_CHECKIN_ALERT=""
NOTIF_ID_REGISTRATION_APPROVAL_REQUEST=""
NOTIF_ID_DAILY_WELLBEING_CHECKIN_REPORT=""
NOTIF_ID_PLATFORM_ENQUIRY=""
NOTIF_ID_ONLINE_SAFETY_SAFEGUARDING_FLAG=""

# Google SSO (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AWS S3 (file uploads) - UK region only
AWS_PROFILE=""
AWS_REGION="eu-west-2"
AWS_BUCKET_NAME=""
AWS_FOLDER_PREFIX=""

# Public site URL (used in metadata / links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
