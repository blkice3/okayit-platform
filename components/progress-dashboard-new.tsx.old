'use client';

import React, { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import {
  BarChart3, TrendingUp, Award, Clock, Video, Gamepad2, BookOpen,
  Download, Share2, Mail, MessageCircle, FileText, Calendar,
  Target, Zap, Star, CheckCircle, ArrowLeft, Activity, X,
  PieChart, AlertCircle, Info, ChevronRight, Filter
} from 'lucide-react';
import { PieChart as RePieChart, Pie, Cell, BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer, LineChart, Line, Area, AreaChart } from 'recharts';
import { Button } from './ui/button';
import { Card, CardContent, CardHeader, CardTitle } from './ui/card';
import { Badge } from './ui/badge';
import { Progress } from './ui/progress';
import { Tabs, TabsContent, TabsList, TabsTrigger } from './ui/tabs';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from './ui/select';
import { okayitTheme, combineThemeClasses } from '@/lib/okayit-theme';
import { toast } from 'sonner';
import OkayitLogo from './okayit-logo';

interface ProgressDashboardProps {
  onBack?: () => void;
  user?: any;
}

interface ProgressData {
  videosWatched: Array<{id: string; title: string; date: string; duration: number}>;
  gamesPlayed: Array<{id: string; title: string; date: string; duration: number; score?: number}>;
  resourcesExplored: Array<{id: string; title: string; category: string; date: string}>;
  certificatesEarned: Array<{id: string; title: string; date: string}>;
  reflectionActivities: Array<{id: string; type: string; date: string; duration: number}>;
  wellbeingCheckIns: Array<{id: string; feeling: string; mood: number; date: string; notes?: string}>;
  totalTimeSpent: number;
  loginStreak: number;
  lastActive: string;
}

// Feelings emoji mapping
const FEELINGS_MAP: Record<string, {icon: React.ElementType; color: string; label: string}> = {
  'happy': { icon: Smile, color: '#FFD700', label: 'Happy' },
  'calm': { icon: Sun, color: '#87CEEB', label: 'Calm' },
  'sad': { icon: Frown, color: '#B0C4DE', label: 'Sad' },
  'anxious': { icon: Cloud, color: '#D3D3D3', label: 'Anxious' },
  'excited': { icon: Zap, color: '#FF6347', label: 'Excited' },
  'tired': { icon: Moon, color: '#9370DB', label: 'Tired' },
  'motivated': { icon: Target, color: '#32CD32', label: 'Motivated' },
  'neutral': { icon: Meh, color: '#A9A9A9', label: 'Neutral' }
};

// Chart colors
const CHART_COLORS = [
  okayitTheme.colors.purple,
  okayitTheme.colors.blue,
  okayitTheme.colors.green,
  okayitTheme.colors.orange,
  okayitTheme.colors.pink,
  '#FFD700',
  '#FF6347',
  '#32CD32'
];

// Initialize or load progress data from localStorage
const getProgressData = (): ProgressData => {
  if (typeof window === 'undefined') return getDefaultProgressData();
  
  const stored = localStorage.getItem('okayit_progress_data');
  if (stored) {
    try {
      const parsed = JSON.parse(stored);
      // Ensure new fields exist
      return {
        ...getDefaultProgressData(),
        ...parsed,
        reflectionActivities: parsed.reflectionActivities || [],
        wellbeingCheckIns: parsed.wellbeingCheckIns || []
      };
    } catch {
      return getDefaultProgressData();
    }
  }
  return getDefaultProgressData();
};

const getDefaultProgressData = (): ProgressData => ({
  videosWatched: [],
  gamesPlayed: [],
  resourcesExplored: [],
  certificatesEarned: [],
  reflectionActivities: [],
  wellbeingCheckIns: [],
  totalTimeSpent: 0,
  loginStreak: 0,
  lastActive: new Date().toISOString()
});

// Save progress data to localStorage
const saveProgressData = (data: ProgressData) => {
  if (typeof window !== 'undefined') {
    localStorage.setItem('okayit_progress_data', JSON.stringify(data));
  }
};

// Export function to track activities from other components
export const trackActivity = (type: 'video' | 'game' | 'resource' | 'certificate' | 'reflection' | 'wellbeing', data: any) => {
  const progressData = getProgressData();
  const timestamp = new Date().toISOString();
  
  switch(type) {
    case 'video':
      progressData.videosWatched.push({
        id: data.id,
        title: data.title,
        date: timestamp,
        duration: data.duration || 0
      });
      break;
    case 'game':
      progressData.gamesPlayed.push({
        id: data.id,
        title: data.title,
        date: timestamp,
        duration: data.duration || 0,
        score: data.score
      });
      break;
    case 'resource':
      progressData.resourcesExplored.push({
        id: data.id,
        title: data.title,
        category: data.category || 'general',
        date: timestamp
      });
      break;
    case 'certificate':
      progressData.certificatesEarned.push({
        id: data.id,
        title: data.title,
        date: timestamp
      });
      break;
    case 'reflection':
      progressData.reflectionActivities.push({
        id: data.id || `reflection-${Date.now()}`,
        type: data.type || 'general',
        date: timestamp,
        duration: data.duration || 0
      });
      break;
    case 'wellbeing':
      progressData.wellbeingCheckIns.push({
        id: data.id || `wellbeing-${Date.now()}`,
        feeling: data.feeling || 'neutral',
        mood: data.mood || 5,
        date: timestamp,
        notes: data.notes
      });
      break;
  }
  
  progressData.lastActive = timestamp;
  saveProgressData(progressData);
};

export default function ProgressDashboard({ onBack, user }: ProgressDashboardProps) {
  const [progressData, setProgressData] = useState<ProgressData>(getDefaultProgressData());
  const [activeTab, setActiveTab] = useState('overview');

  useEffect(() => {
    setProgressData(getProgressData());
  }, []);

  // Calculate weekly summary
  const getWeeklySummary = () => {
    const oneWeekAgo = new Date();
    oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);

    return {
      videos: progressData.videosWatched.filter(v => new Date(v.date) > oneWeekAgo).length,
      games: progressData.gamesPlayed.filter(g => new Date(g.date) > oneWeekAgo).length,
      resources: progressData.resourcesExplored.filter(r => new Date(r.date) > oneWeekAgo).length,
      reflections: progressData.reflectionActivities.filter(r => new Date(r.date) > oneWeekAgo).length,
      wellbeing: progressData.wellbeingCheckIns.filter(w => new Date(w.date) > oneWeekAgo).length
    };
  };

  // Prepare data for pie chart - Activity Distribution
  const getActivityDistribution = () => {
    return [
      { name: 'Videos', value: progressData.videosWatched.length, color: CHART_COLORS[0] },
      { name: 'Games', value: progressData.gamesPlayed.length, color: CHART_COLORS[1] },
      { name: 'Resources', value: progressData.resourcesExplored.length, color: CHART_COLORS[2] },
      { name: 'Reflections', value: progressData.reflectionActivities.length, color: CHART_COLORS[3] },
      { name: 'Check-ins', value: progressData.wellbeingCheckIns.length, color: CHART_COLORS[4] }
    ].filter(item => item.value > 0);
  };

  // Prepare data for bar chart - Weekly Activity
  const getWeeklyActivityData = () => {
    const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
    const data = days.map(day => ({
      day,
      videos: 0,
      games: 0,
      resources: 0,
      reflections: 0,
      wellbeing: 0
    }));

    const oneWeekAgo = new Date();
    oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);

    // Aggregate activities by day of week
    [...progressData.videosWatched, ...progressData.gamesPlayed, ...progressData.resourcesExplored, 
     ...progressData.reflectionActivities, ...progressData.wellbeingCheckIns].forEach(activity => {
      const activityDate = new Date(activity.date);
      if (activityDate > oneWeekAgo) {
        const dayIndex = (activityDate.getDay() + 6) % 7; // Convert Sunday=0 to Monday=0
        if ('title' in activity && 'duration' in activity) {
          if (progressData.videosWatched.includes(activity as any)) data[dayIndex].videos++;
          else if (progressData.gamesPlayed.includes(activity as any)) data[dayIndex].games++;
        } else if ('category' in activity) {
          data[dayIndex].resources++;
        } else if ('type' in activity) {
          data[dayIndex].reflections++;
        } else if ('feeling' in activity) {
          data[dayIndex].wellbeing++;
        }
      }
    });

    return data;
  };

  // Get feelings distribution
  const getFeelingsDistribution = () => {
    const feelingCounts: Record<string, number> = {};
    progressData.wellbeingCheckIns.forEach(checkin => {
      feelingCounts[checkin.feeling] = (feelingCounts[checkin.feeling] || 0) + 1;
    });

    return Object.entries(feelingCounts).map(([feeling, count]) => ({
      name: FEELINGS_MAP[feeling]?.label || feeling,
      value: count,
      color: FEELINGS_MAP[feeling]?.color || '#gray'
    }));
  };

  // Mood trend over time (last 7 check-ins)
  const getMoodTrend = () => {
    return progressData.wellbeingCheckIns
      .slice(-7)
      .map((checkin, index) => ({
        checkIn: `#${index + 1}`,
        mood: checkin.mood,
        date: new Date(checkin.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' })
      }));
  };

  const weeklySummary = getWeeklySummary();
  const activityDistribution = getActivityDistribution();
  const weeklyActivity = getWeeklyActivityData();
  const feelingsDistribution = getFeelingsDistribution();
  const moodTrend = getMoodTrend();

  const handleDownload = () => {
    const content = generateProgressReport(progressData);
    const blob = new Blob([content], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `progress-report-${new Date().toISOString().split('T')[0]}.txt`;
    a.click();
    URL.revokeObjectURL(url);
    toast.success('Progress report downloaded!');
  };

  const handleShare = (method: 'email' | 'whatsapp') => {
    const content = generateProgressReport(progressData);
    
    if (method === 'email') {
      const subject = encodeURIComponent('My OKAYiT Progress Report');
      const body = encodeURIComponent(content);
      window.location.href = `mailto:?subject=${subject}&body=${body}`;
    } else {
      const text = encodeURIComponent(content);
      window.open(`https://wa.me/?text=${text}`, '_blank');
    }
    
    toast.success(`Opening ${method} to share your progress!`);
  };

  const handleClearData = () => {
    if (confirm('Are you sure you want to clear all progress data? This cannot be undone.')) {
      const defaultData = getDefaultProgressData();
      setProgressData(defaultData);
      saveProgressData(defaultData);
      toast.success('Progress data cleared');
    }
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-purple-50 via-blue-50 to-pink-50">
      {/* Header */}
      <motion.header
        initial={{ y: -100, opacity: 0 }}
        animate={{ y: 0, opacity: 1 }}
        className="sticky top-0 z-40 bg-white/95 backdrop-blur-lg shadow-xl border-b-4 border-purple-300"
      >
        <div className="container mx-auto px-4 sm:px-6 py-4">
          <div className="flex flex-col sm:flex-row items-center justify-between gap-4">
            <div className="flex items-center gap-4">
              <OkayitLogo width={60} height={60} />
              <div>
                <h1 className="text-2xl sm:text-3xl font-black bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent">
                  My Progress Dashboard
                </h1>
                <p className="text-sm text-gray-600 mt-1">Track your journey and celebrate achievements</p>
              </div>
            </div>
            
            {onBack && (
              <Button onClick={onBack} variant="outline" size="lg" className="gap-2">
                <ArrowLeft className="w-5 h-5" />
                <span className="hidden sm:inline">Back to Menu</span>
              </Button>
            )}
          </div>
        </div>
      </motion.header>

      {/* Main Content */}
      <div className="container mx-auto px-4 sm:px-6 py-6 sm:py-8">
        <Tabs value={activeTab} onValueChange={setActiveTab} className="space-y-6">
          <TabsList className="grid w-full grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 bg-white p-2 rounded-2xl shadow-lg">
            <TabsTrigger value="overview" className="flex items-center gap-2 data-[state=active]:bg-gradient-to-r data-[state=active]:from-purple-500 data-[state=active]:to-pink-500 data-[state=active]:text-white">
              <BarChart3 className="w-4 h-4" />
              <span className="hidden sm:inline">Overview</span>
            </TabsTrigger>
            <TabsTrigger value="videos" className="flex items-center gap-2 data-[state=active]:bg-gradient-to-r data-[state=active]:from-blue-500 data-[state=active]:to-cyan-500 data-[state=active]:text-white">
              <Video className="w-4 h-4" />
              <span className="hidden sm:inline">Videos</span>
            </TabsTrigger>
            <TabsTrigger value="games" className="flex items-center gap-2 data-[state=active]:bg-gradient-to-r data-[state=active]:from-green-500 data-[state=active]:to-teal-500 data-[state=active]:text-white">
              <Gamepad2 className="w-4 h-4" />
              <span className="hidden sm:inline">Games</span>
            </TabsTrigger>
            <TabsTrigger value="resources" className="flex items-center gap-2 data-[state=active]:bg-gradient-to-r data-[state=active]:from-orange-500 data-[state=active]:to-red-500 data-[state=active]:text-white">
              <BookOpen className="w-4 h-4" />
              <span className="hidden sm:inline">Resources</span>
            </TabsTrigger>
            <TabsTrigger value="wellbeing" className="flex items-center gap-2 data-[state=active]:bg-gradient-to-r data-[state=active]:from-pink-500 data-[state=active]:to-rose-500 data-[state=active]:text-white">
              <Heart className="w-4 h-4" />
              <span className="hidden sm:inline">Wellbeing</span>
            </TabsTrigger>
            <TabsTrigger value="reflection" className="flex items-center gap-2 data-[state=active]:bg-gradient-to-r data-[state=active]:from-indigo-500 data-[state=active]:to-purple-500 data-[state=active]:text-white">
              <Brain className="w-4 h-4" />
              <span className="hidden sm:inline">Reflection</span>
            </TabsTrigger>
          </TabsList>

          {/* Overview Tab */}
          <TabsContent value="overview" className="space-y-6">
            {/* Stats Cards */}
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
              <StatsCard
                title="Total Activities"
                value={progressData.videosWatched.length + progressData.gamesPlayed.length + progressData.resourcesExplored.length + progressData.reflectionActivities.length + progressData.wellbeingCheckIns.length}
                icon={Activity}
                color="from-purple-500 to-pink-500"
              />
              <StatsCard
                title="This Week"
                value={weeklySummary.videos + weeklySummary.games + weeklySummary.resources + weeklySummary.reflections + weeklySummary.wellbeing}
                icon={TrendingUp}
                color="from-blue-500 to-cyan-500"
              />
              <StatsCard
                title="Certificates"
                value={progressData.certificatesEarned.length}
                icon={Award}
                color="from-green-500 to-teal-500"
              />
              <StatsCard
                title="Login Streak"
                value={`${progressData.loginStreak} days`}
                icon={Zap}
                color="from-orange-500 to-red-500"
              />
            </div>

            {/* Charts Section */}
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
              {/* Activity Distribution Pie Chart */}
              <Card className="border-0 shadow-xl">
                <CardHeader>
                  <CardTitle className="flex items-center gap-2">
                    <Activity className="w-5 h-5 text-purple-600" />
                    Activity Distribution
                  </CardTitle>
                </CardHeader>
                <CardContent>
                  {activityDistribution.length > 0 ? (
                    <ResponsiveContainer width="100%" height={300}>
                      <RePieChart>
                        <Pie
                          data={activityDistribution}
                          cx="50%"
                          cy="50%"
                          labelLine={false}
                          label={({ name, percent }) => `${name} ${(percent * 100).toFixed(0)}%`}
                          outerRadius={80}
                          fill="#8884d8"
                          dataKey="value"
                        >
                          {activityDistribution.map((entry, index) => (
                            <Cell key={`cell-${index}`} fill={entry.color} />
                          ))}
                        </Pie>
                        <Tooltip />
                      </RePieChart>
                    </ResponsiveContainer>
                  ) : (
                    <div className="h-[300px] flex items-center justify-center text-gray-400">
                      <div className="text-center">
                        <Activity className="w-12 h-12 mx-auto mb-2 opacity-50" />
                        <p>No activities yet. Start exploring!</p>
                      </div>
                    </div>
                  )}
                </CardContent>
              </Card>

              {/* Weekly Activity Bar Chart */}
              <Card className="border-0 shadow-xl">
                <CardHeader>
                  <CardTitle className="flex items-center gap-2">
                    <BarChart3 className="w-5 h-5 text-blue-600" />
                    Weekly Activity
                  </CardTitle>
                </CardHeader>
                <CardContent>
                  <ResponsiveContainer width="100%" height={300}>
                    <BarChart data={weeklyActivity}>
                      <CartesianGrid strokeDasharray="3 3" />
                      <XAxis dataKey="day" />
                      <YAxis />
                      <Tooltip />
                      <Legend />
                      <Bar dataKey="videos" fill={CHART_COLORS[0]} name="Videos" />
                      <Bar dataKey="games" fill={CHART_COLORS[1]} name="Games" />
                      <Bar dataKey="resources" fill={CHART_COLORS[2]} name="Resources" />
                      <Bar dataKey="reflections" fill={CHART_COLORS[3]} name="Reflections" />
                      <Bar dataKey="wellbeing" fill={CHART_COLORS[4]} name="Check-ins" />
                    </BarChart>
                  </ResponsiveContainer>
                </CardContent>
              </Card>
            </div>

            {/* Feelings & Mood Section */}
            {progressData.wellbeingCheckIns.length > 0 && (
              <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                {/* Feelings Distribution */}
                <Card className="border-0 shadow-xl">
                  <CardHeader>
                    <CardTitle className="flex items-center gap-2">
                      <Smile className="w-5 h-5 text-pink-600" />
                      How I've Been Feeling
                    </CardTitle>
                  </CardHeader>
                  <CardContent>
                    {feelingsDistribution.length > 0 ? (
                      <ResponsiveContainer width="100%" height={300}>
                        <RePieChart>
                          <Pie
                            data={feelingsDistribution}
                            cx="50%"
                            cy="50%"
                            labelLine={false}
                            label={({ name, percent }) => `${name} ${(percent * 100).toFixed(0)}%`}
                            outerRadius={80}
                            fill="#8884d8"
                            dataKey="value"
                          >
                            {feelingsDistribution.map((entry, index) => (
                              <Cell key={`cell-${index}`} fill={entry.color} />
                            ))}
                          </Pie>
                          <Tooltip />
                        </RePieChart>
                      </ResponsiveContainer>
                    ) : null}
                  </CardContent>
                </Card>

                {/* Mood Trend */}
                <Card className="border-0 shadow-xl">
                  <CardHeader>
                    <CardTitle className="flex items-center gap-2">
                      <TrendingUp className="w-5 h-5 text-green-600" />
                      Mood Trend
                    </CardTitle>
                  </CardHeader>
                  <CardContent>
                    {moodTrend.length > 0 ? (
                      <ResponsiveContainer width="100%" height={300}>
                        <LineChart data={moodTrend}>
                          <CartesianGrid strokeDasharray="3 3" />
                          <XAxis dataKey="date" />
                          <YAxis domain={[0, 10]} />
                          <Tooltip />
                          <Legend />
                          <Line type="monotone" dataKey="mood" stroke="#8B5CF6" strokeWidth={3} name="Mood Score" />
                        </LineChart>
                      </ResponsiveContainer>
                    ) : null}
                  </CardContent>
                </Card>
              </div>
            )}

            {/* Action Buttons */}
            <Card className="border-0 shadow-xl bg-gradient-to-r from-purple-50 to-pink-50">
              <CardHeader>
                <CardTitle>Share Your Progress</CardTitle>
              </CardHeader>
              <CardContent>
                <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                  <Button onClick={handleDownload} className="gap-2 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700">
                    <Download className="w-4 h-4" />
                    Download Report
                  </Button>
                  <Button onClick={() => handleShare('email')} variant="outline" className="gap-2">
                    <Mail className="w-4 h-4" />
                    Email Report
                  </Button>
                  <Button onClick={() => handleShare('whatsapp')} variant="outline" className="gap-2">
                    <MessageCircle className="w-4 h-4" />
                    Share on WhatsApp
                  </Button>
                  <Button onClick={handleClearData} variant="destructive" className="gap-2">
                    <X className="w-4 h-4" />
                    Clear All Data
                  </Button>
                </div>
              </CardContent>
            </Card>
          </TabsContent>

          {/* Videos Tab */}
          <TabsContent value="videos">
            <ActivityList
              title="Videos Watched"
              items={progressData.videosWatched}
              emptyMessage="No videos watched yet. Check out the Story Experience!"
              icon={Video}
              color="from-blue-500 to-cyan-500"
            />
          </TabsContent>

          {/* Games Tab */}
          <TabsContent value="games">
            <ActivityList
              title="Games Played"
              items={progressData.gamesPlayed}
              emptyMessage="No games played yet. Visit Family Gaming!"
              icon={Gamepad2}
              color="from-green-500 to-teal-500"
              showScore
            />
          </TabsContent>

          {/* Resources Tab */}
          <TabsContent value="resources">
            <ActivityList
              title="Resources Explored"
              items={progressData.resourcesExplored}
              emptyMessage="No resources explored yet. Check out the Digital Library!"
              icon={BookOpen}
              color="from-orange-500 to-red-500"
            />
          </TabsContent>

          {/* Wellbeing Tab */}
          <TabsContent value="wellbeing">
            <Card className="border-0 shadow-xl">
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <Heart className="w-5 h-5 text-pink-600" />
                  Wellbeing Check-Ins
                </CardTitle>
              </CardHeader>
              <CardContent>
                {progressData.wellbeingCheckIns.length === 0 ? (
                  <div className="text-center py-12 text-gray-400">
                    <Heart className="w-16 h-16 mx-auto mb-4 opacity-50" />
                    <p>No wellbeing check-ins yet. Start checking in daily!</p>
                  </div>
                ) : (
                  <div className="space-y-4">
                    {progressData.wellbeingCheckIns.slice().reverse().map((checkin, index) => {
                      const FeelingIcon = FEELINGS_MAP[checkin.feeling]?.icon || Meh;
                      const feelingColor = FEELINGS_MAP[checkin.feeling]?.color || '#gray';
                      
                      return (
                        <motion.div
                          key={index}
                          initial={{ opacity: 0, x: -20 }}
                          animate={{ opacity: 1, x: 0 }}
                          transition={{ delay: index * 0.05 }}
                          className="flex items-start gap-4 p-4 rounded-xl bg-gradient-to-r from-pink-50 to-purple-50 border-2 border-pink-200"
                        >
                          <div 
                            className="p-3 rounded-full"
                            style={{ backgroundColor: feelingColor + '40' }}
                          >
                            <FeelingIcon className="w-6 h-6" style={{ color: feelingColor }} />
                          </div>
                          <div className="flex-1">
                            <div className="flex items-center justify-between mb-2">
                              <h4 className="font-bold text-gray-800">
                                Feeling {FEELINGS_MAP[checkin.feeling]?.label || checkin.feeling}
                              </h4>
                              <Badge variant="outline">Mood: {checkin.mood}/10</Badge>
                            </div>
                            {checkin.notes && (
                              <p className="text-sm text-gray-600 mb-2">{checkin.notes}</p>
                            )}
                            <p className="text-xs text-gray-400">
                              {new Date(checkin.date).toLocaleString('en-GB', { 
                                day: '2-digit', 
                                month: 'long', 
                                year: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit'
                              })}
                            </p>
                          </div>
                        </motion.div>
                      );
                    })}
                  </div>
                )}
              </CardContent>
            </Card>
          </TabsContent>

          {/* Reflection Tab */}
          <TabsContent value="reflection">
            <Card className="border-0 shadow-xl">
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <Brain className="w-5 h-5 text-indigo-600" />
                  Reflection Activities
                </CardTitle>
              </CardHeader>
              <CardContent>
                {progressData.reflectionActivities.length === 0 ? (
                  <div className="text-center py-12 text-gray-400">
                    <Brain className="w-16 h-16 mx-auto mb-4 opacity-50" />
                    <p>No reflection activities yet. Visit the Reflection Toolkit!</p>
                  </div>
                ) : (
                  <div className="space-y-4">
                    {progressData.reflectionActivities.slice().reverse().map((activity, index) => (
                      <motion.div
                        key={index}
                        initial={{ opacity: 0, x: -20 }}
                        animate={{ opacity: 1, x: 0 }}
                        transition={{ delay: index * 0.05 }}
                        className="flex items-start gap-4 p-4 rounded-xl bg-gradient-to-r from-indigo-50 to-purple-50 border-2 border-indigo-200"
                      >
                        <div className="p-3 rounded-full bg-indigo-200">
                          <Brain className="w-6 h-6 text-indigo-600" />
                        </div>
                        <div className="flex-1">
                          <div className="flex items-center justify-between mb-2">
                            <h4 className="font-bold text-gray-800 capitalize">{activity.type} Reflection</h4>
                            {activity.duration > 0 && (
                              <Badge variant="outline">{activity.duration} mins</Badge>
                            )}
                          </div>
                          <p className="text-xs text-gray-400">
                            {new Date(activity.date).toLocaleString('en-GB', { 
                              day: '2-digit', 
                              month: 'long', 
                              year: 'numeric',
                              hour: '2-digit',
                              minute: '2-digit'
                            })}
                          </p>
                        </div>
                      </motion.div>
                    ))}
                  </div>
                )}
              </CardContent>
            </Card>
          </TabsContent>
        </Tabs>
      </div>
    </div>
  );
}

// Stats Card Component
interface StatsCardProps {
  title: string;
  value: string | number;
  icon: React.ElementType;
  color: string;
}

function StatsCard({ title, value, icon: Icon, color }: StatsCardProps) {
  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      whileHover={{ scale: 1.05, y: -5 }}
      className="relative overflow-hidden"
    >
      <Card className={`border-0 shadow-xl bg-gradient-to-br ${color} text-white`}>
        <CardContent className="p-6">
          <div className="flex items-start justify-between">
            <div>
              <p className="text-white/80 text-sm mb-1">{title}</p>
              <h3 className="text-3xl sm:text-4xl font-black">{value}</h3>
            </div>
            <Icon className="w-10 h-10 sm:w-12 sm:h-12 opacity-80" />
          </div>
        </CardContent>
      </Card>
    </motion.div>
  );
}

// Activity List Component
interface ActivityListProps {
  title: string;
  items: any[];
  emptyMessage: string;
  icon: React.ElementType;
  color: string;
  showScore?: boolean;
}

function ActivityList({ title, items, emptyMessage, icon: Icon, color, showScore }: ActivityListProps) {
  return (
    <Card className="border-0 shadow-xl">
      <CardHeader>
        <CardTitle className="flex items-center gap-2">
          <Icon className="w-5 h-5" />
          {title}
        </CardTitle>
      </CardHeader>
      <CardContent>
        {items.length === 0 ? (
          <div className="text-center py-12 text-gray-400">
            <Icon className="w-16 h-16 mx-auto mb-4 opacity-50" />
            <p>{emptyMessage}</p>
          </div>
        ) : (
          <div className="space-y-4">
            {items.slice().reverse().map((item, index) => (
              <motion.div
                key={index}
                initial={{ opacity: 0, x: -20 }}
                animate={{ opacity: 1, x: 0 }}
                transition={{ delay: index * 0.05 }}
                className={`flex items-start gap-4 p-4 rounded-xl bg-gradient-to-r ${color} bg-opacity-10 border-2`}
                style={{ borderColor: CHART_COLORS[index % CHART_COLORS.length] + '40' }}
              >
                <div 
                  className="p-3 rounded-full"
                  style={{ backgroundColor: CHART_COLORS[index % CHART_COLORS.length] + '20' }}
                >
                  <Icon className="w-6 h-6" style={{ color: CHART_COLORS[index % CHART_COLORS.length] }} />
                </div>
                <div className="flex-1">
                  <div className="flex items-center justify-between mb-2">
                    <h4 className="font-bold text-gray-800">{item.title || 'Activity'}</h4>
                    {showScore && item.score !== undefined && (
                      <Badge variant="outline">Score: {item.score}</Badge>
                    )}
                    {item.duration !== undefined && (
                      <Badge variant="outline">{item.duration} mins</Badge>
                    )}
                    {item.category && (
                      <Badge variant="outline" className="capitalize">{item.category}</Badge>
                    )}
                  </div>
                  <p className="text-xs text-gray-400">
                    {new Date(item.date).toLocaleString('en-GB', { 
                      day: '2-digit', 
                      month: 'long', 
                      year: 'numeric',
                      hour: '2-digit',
                      minute: '2-digit'
                    })}
                  </p>
                </div>
              </motion.div>
            ))}
          </div>
        )}
      </CardContent>
    </Card>
  );
}

// Generate text report for download/sharing
function generateProgressReport(data: ProgressData): string {
  const totalActivities = data.videosWatched.length + data.gamesPlayed.length + 
                          data.resourcesExplored.length + data.reflectionActivities.length + 
                          data.wellbeingCheckIns.length;

  return `
===========================================
       OKAYiT PROGRESS REPORT
===========================================

Generated: ${new Date().toLocaleString('en-GB')}

SUMMARY
-------
Total Activities: ${totalActivities}
Videos Watched: ${data.videosWatched.length}
Games Played: ${data.gamesPlayed.length}
Resources Explored: ${data.resourcesExplored.length}
Reflection Activities: ${data.reflectionActivities.length}
Wellbeing Check-Ins: ${data.wellbeingCheckIns.length}
Certificates Earned: ${data.certificatesEarned.length}
Login Streak: ${data.loginStreak} days
Last Active: ${new Date(data.lastActive).toLocaleString('en-GB')}

RECENT ACTIVITIES
-----------------
${data.videosWatched.slice(-5).reverse().map(v => 
  `✓ Video: ${v.title} (${new Date(v.date).toLocaleDateString('en-GB')})`
).join('\n')}

${data.gamesPlayed.slice(-5).reverse().map(g => 
  `✓ Game: ${g.title} ${g.score ? `- Score: ${g.score}` : ''} (${new Date(g.date).toLocaleDateString('en-GB')})`
).join('\n')}

${data.resourcesExplored.slice(-5).reverse().map(r => 
  `✓ Resource: ${r.title} (${new Date(r.date).toLocaleDateString('en-GB')})`
).join('\n')}

${data.reflectionActivities.slice(-5).reverse().map(r => 
  `✓ Reflection: ${r.type} (${new Date(r.date).toLocaleDateString('en-GB')})`
).join('\n')}

WELLBEING SUMMARY
-----------------
${data.wellbeingCheckIns.slice(-5).reverse().map(w => 
  `✓ Feeling: ${w.feeling} - Mood: ${w.mood}/10 (${new Date(w.date).toLocaleDateString('en-GB')})`
).join('\n')}

===========================================
Keep up the great work! 🌟
For support: admin@okayit.uk
===========================================
  `.trim();
}
